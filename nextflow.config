params {
    samplesheet                  = "$baseDir/assets/samplesheet_1.tsv"
    pretrained_model             = "$baseDir/data/pretrained_hg19_12l"
    outdir                       = "$baseDir/results"

    // Training
    epoch                        = 1
    batch_size_per_gpu           = 384        // per-GPU micro batch size
    gradient_accumulation_steps  = 8
    lr                           = 1e-4
    warmup_ratio                 = 0.06      // fraction of total optimizer steps
    decay_start_ratio            = 0.90      // step fraction where LR decay begins (decay to end)
    precision                    = 'bf16'    // fp16 | bf16 | fp32
    seed                         = 42
    best_metric                  = 'accuracy'     // auc | pr_auc | balanced_accuracy | accuracy | loss
    val_every_steps              = 400         // 0 = validate once per epoch (low frequency)

    // Sharding / data loading
    shard_size                   = 200000
    dataloader_workers           = 4
    infer_batch_size             = 256

    // Resources
    ft_gpus                      = 4
}

process {
    executor = 'slurm'

    // Disabled by default; each process opts in via its own publishDir directive
    // in main.nf so intermediate parquet / tokenized shards are not published.
    publishDir = [ path: { "${params.outdir}/_intermediate" }, enabled: false ]

    withName: 'PREPROCESS' {
        container = "$baseDir/images/methylbert_v2.0.2.sif"
        cpus      = 16
        memory    = 64.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'TOKENIZE_SHARDS' {
        container = "$baseDir/images/methylbert_v2.0.2.sif"
        cpus      = 16
        memory    = 64.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'FINETUNE' {
        container      = "$baseDir/images/methylbert_v2.0.2.sif"
        cpus           = 32
        memory         = 256.GB
        queue          = 'gpu_a800'
        clusterOptions = "--gres=gpu:${params.ft_gpus}"
    }

    withName: 'READLEVEL_INFER' {
        container      = "$baseDir/images/methylbert_v2.0.2.sif"
        cpus           = 16
        memory         = 128.GB
        time           = 24.h
        queue          = 'gpu_l40'
        clusterOptions = '--gres=gpu:1'
    }
}

profiles {
    l40 {
        includeConfig 'conf/l40.config'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B /lustre1,/lustre2 --nv"
    }
    l48 {
        includeConfig 'conf/l48.config'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B /lustre1,/lustre2 --nv"
    }
    a800 {
        includeConfig 'conf/a800.config'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B /lustre1,/lustre2 --nv"
    }
}

// Per-process / per-sample timing and resource usage.
def trace_ts = new java.util.Date().format('yyyyMMdd_HHmmss')
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_ts}.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar'
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_ts}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_ts}.html"
}
